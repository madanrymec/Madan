// Initialize range flatpickr with single-date fallback handling
flatpickr("#my-date-picker", {
    mode: "range",
    dateFormat: "d/m/Y",
    defaultDate: [
        document.getElementById('start_date').value.split("-").reverse().join("/"),
        document.getElementById('end_date').value.split("-").reverse().join("/")
    ],
    onClose: function(selectedDates) {
        if (selectedDates.length > 0) {
            const startDate = selectedDates[0].toISOString().split('T')[0];
            // Fallback: If only 1 date is picked, end_date becomes identical to start_date
            const endDate = selectedDates.length === 2 ? selectedDates[1].toISOString().split('T')[0] : startDate;
            
            document.getElementById('start_date').value = startDate;
            document.getElementById('end_date').value = endDate;
        }
    }
});

