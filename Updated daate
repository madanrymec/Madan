            CASE WHEN Sales_office = 'Bangalore - IMD' THEN 'InternationalMarket' ELSE Sales_Region_Name END AS display_region, 
            SUM(Net_Value)/100000 AS actual
        FROM billing_data
        WHERE Billing_Date BETWEEN %s AND %s AND Dist_Channel_TEXT != 'Inter Unit Transfer'
        GROUP BY display_region
    """, (start_date, end_date))
    actual_dict = {r['display_region']: float(r['actual'] or 0) for r in cursor.fetchall()}

    cursor.execute(
        "SELECT Sales_Region_Name as region, (SUM(Target)/365)*%s as daily_target FROM billing_target WHERE fin_year=%s GROUP BY region",
