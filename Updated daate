## 2. Backend Updates (`app.py`)

The Python endpoints read `start_date` and `end_date`. If they match (a single date), `days_in_range` resolves to `1`, keeping your baseline daily math unchanged. If they differ, the metric scaling adapts automatically.

```python
from datetime import datetime
from flask import request, jsonify, render_template

@app.route('/daily')
@requires_login
def daily_dashboard():
    # If parameters aren't supplied, default to execution day as single-day view
    today_date = datetime.now().strftime('%Y-%m-%d')
    start_date = request.args.get('start_date', today_date)
    end_date = request.args.get('end_date', today_date)
    return render_template('daily_sales.html', start_date=start_date, end_date=end_date, username=session['username'])

@app.route('/get_daily_summary')
def get_daily_summary():
    start_date_str = request.args.get('start_date')
    end_date_str = request.args.get('end_date')
    
    if not start_date_str or not end_date_str:
        return jsonify({"error": "Missing date window boundaries"}), 400

    start_date = datetime.strptime(start_date_str, '%Y-%m-%d')
    end_date = datetime.strptime(end_date_str, '%Y-%m-%d')
    
    # Resolves to 1 day for single selections, scaling automatically for longer spans
    days_in_range = (end_date - start_date).days + 1

    month = start_date.month
    year = start_date.year
    fin_year = f"{year}-{year + 1}" if month >= 4 else f"{year - 1}-{year}"
    mtd_start = start_date.replace(day=1).strftime('%Y-%m-%d')

    conn = get_db_connection()
    cursor = conn.cursor()

    try:
        # 1. Net Value Aggregation 
        cursor.execute("""
            SELECT SUM(Net_Value)/100000 AS total FROM billing_data 
            WHERE Billing_Date BETWEEN %s AND %s AND Dist_Channel_TEXT != 'Inter Unit Transfer'
        """, (start_date_str, end_date_str))
        today_net = cursor.fetchone()['total'] or 0

        # 2. Main Sales Figures
        cursor.execute("""
            SELECT SUM(Net_Value)/100000 AS total FROM billing_data 
            WHERE Billing_Date BETWEEN %s AND %s AND Dist_Channel_TEXT != 'Inter Unit Transfer' AND Unit != 'UN07'
        """, (start_date_str, end_date_str))
        today_actual = cursor.fetchone()['total'] or 0

        # 3. Cumulative Month to Date
        cursor.execute("""
            SELECT SUM(Net_Value)/100000 AS total FROM billing_data 
            WHERE Billing_Date >= %s AND Billing_Date <= %s 
        """, (mtd_start, end_date_str))
        mtd_actual = cursor.fetchone()['total'] or 0

        # 4. Proportional Target Calculation (Daily target * span width)
        cursor.execute("SELECT SUM(Target) as annual FROM billing_target WHERE fin_year=%s", (fin_year,))
        annual_target = cursor.fetchone()['annual'] or 0

        daily_target = (annual_target / 365) * days_in_range
        achievement = (today_actual / daily_target * 100) if daily_target > 0 else 0

        # 5. Inter Unit Transfers
        cursor.execute("""
            SELECT SUM(Net_Value)/100000 AS total FROM billing_data 
            WHERE Billing_Date BETWEEN %s AND %s AND Dist_Channel_TEXT = 'Inter Unit Transfer'
        """, (start_date_str, end_date_str))
        today_iut = cursor.fetchone()['total'] or 0

        # 6. Scrap Sales
        cursor.execute("""
            SELECT SUM(Net_Value)/100000 AS total FROM billing_data 
            WHERE Billing_Date BETWEEN %s AND %s AND Unit = 'UN07'
        """, (start_date_str, end_date_str))
        today_scrap = cursor.fetchone()['total'] or 0

        return jsonify({
            "today_net_value": f"{float(today_net):,.5f}",
            "today_actual": f"{float(today_actual):,.5f}",
            "today_target": f"{float(daily_target):,.0f}",
            "achievement": round(achievement, 1),
            "mtd_actual": f"{float(mtd_actual):,.5f}",
            "today_iut": f"{float(today_iut):,.5f}",
            "today_scrap": f"{float(today_scrap):,.5f}"
        })
    finally:
        conn.close()

@app.route('/get_daily_products')
def get_daily_products():
    start_date = request.args.get('start_date')
    end_date = request.args.get('end_date')
    
    date_obj = datetime.strptime(start_date, '%Y-%m-%d')
    end_date_obj = datetime.strptime(end_date, '%Y-%m-%d')
    days_in_range = (end_date_obj - date_obj).days + 1
    fin_year = f"{date_obj.year}-{date_obj.year + 1}" if date_obj.month >= 4 else f"{date_obj.year - 1}-{date_obj.year}"

    conn = get_db_connection()
    cursor = conn.cursor()

    cursor.execute("""
        SELECT 
            CASE 
                WHEN Prod = 'LV MOTORS' AND Plant = 'AC02' THEN 'LV MOTORS (NS)'
                WHEN Prod = 'LV MOTORS' AND Plant = 'AC25' THEN 'LV MOTORS (S)'
                WHEN Prod = 'TRANSFORMERS MYSORE' AND VTEXT1='Switchgear' THEN 'SWITCHGEARS'
                ELSE Prod
            END AS display_prod, 
            SUM(Net_Value)/100000 as actual
        FROM billing_data 
        WHERE Billing_Date BETWEEN %s AND %s AND Dist_Channel_TEXT != 'Inter Unit Transfer'
        GROUP BY display_prod
    """, (start_date, end_date))
    actual_map = {r['display_prod']: float(r['actual'] or 0) for r in cursor.fetchall()}

    cursor.execute(
        "SELECT Product, (SUM(Target)/365)*%s as daily_target FROM billing_target WHERE fin_year=%s GROUP BY Product",
        (days_in_range, fin_year))
    target_map = {r['Product']: float(r['daily_target'] or 0) for r in cursor.fetchall()}
    conn.close()

    PRODUCT_MAP = [
        ('DC MACHINES', 'DCM'), ('HV MOTORS', 'HVM'), ('HV GENERATORS', 'HVG'),
        ('RRM', 'RRM'), ('LV MOTORS (NS)', 'LVM(NS)'), ('LV MOTORS (S)', 'LVM(S)'),
        ('EVM', 'EVM'), ('LV GENERATORS', 'LVG'), ('DG SETS', 'DGS'),
        ('TRANSFORMERS PUNE', 'TRF(P)'), ('TRANSFORMERS MYSORE', 'TRF(M)'),
        ('SWITCHGEARS', 'SWG'), ('SPARES & SERVICE', 'SP&S')
    ]

    return jsonify({
        "labels": [p[1] for p in PRODUCT_MAP],
        "actuals": [actual_map.get(p[0], 0) for p in PRODUCT_MAP],
        "targets": [target_map.get(p[0], 0) for p in PRODUCT_MAP]
    })

