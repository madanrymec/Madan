### 1. Updated Python Backend (`app.py`)

Add these imports at the top, configure your email credentials (I used Outlook's IMAP server as a default for enterprise emails; change to `imap.gmail.com` if using Gmail Workspace), and replace your `/api/candidates` route with the updated grouped logic.

```python
import os
import imaplib
import email
from email.header import decode_header
from werkzeug.utils import secure_filename
import PyPDF2

# --- File Upload Configuration ---
UPLOAD_FOLDER = 'static/uploads/resumes'
app.config['UPLOAD_FOLDER'] = UPLOAD_FOLDER
os.makedirs(UPLOAD_FOLDER, exist_ok=True)

# --- Email Automation Configuration ---
EMAIL_ACCOUNT = "madan.hs@kec.com"
EMAIL_APP_PASSWORD = "your_app_password_here"
IMAP_SERVER = "outlook.office365.com" # Change to 'imap.gmail.com' if using Google Workspace

def extract_name_from_pdf(filepath):
    """Attempts to extract the candidate's name from the first line of the PDF."""
    try:
        with open(filepath, 'rb') as f:
            reader = PyPDF2.PdfReader(f)
            text = reader.pages[0].extract_text()
            if text:
                lines = text.split('\n')
                # Usually the first non-empty line of a resume is the name
                for line in lines:
                    if line.strip():
                        return line.strip()[:50]
    except Exception as e:
        print(f"PDF extraction error: {e}")
    return "Unknown Candidate"


@app.route('/api/candidates', methods=['GET'])
def get_candidates():
    """Fetch candidates grouped by Job ID, attaching Location and Role."""
    conn = get_db_connection()
    try:
        with conn.cursor() as c:
            # Fetch Job details from summary to map location and role
            c.execute("SELECT generated_code, location, position FROM summary")
            job_details = {row['generated_code']: row for row in c.fetchall()}

            c.execute("SELECT * FROM candidate_mast")
            cands = c.fetchall()

            groups = {}
            for cand in cands:
                jcode = cand['job_code']
                if jcode not in groups:
                    groups[jcode] = {
                        "jobCode": jcode,
                        "location": job_details.get(jcode, {}).get('location', 'Unknown'),
                        "role": job_details.get(jcode, {}).get('position', 'Unknown'),
                        "candidates": []
                    }

                cand_obj = {
                    "id": cand['candidate_id'],
                    "name": cand['candidate_name'],
                    "role": cand['candidate_role'],
                    "appliedOn": cand['applied_date'].strftime('%Y-%m-%d') if cand['applied_date'] else None,
                    "resumeFile": cand['resume_path'],
                    "hr": {"status": "not-scheduled", "interviewer": None, "interviewDate": None, "feedback": None},
                    "tech": {"status": "not-scheduled", "interviewer": None, "interviewDate": None, "feedback": None}
                }

                # Fetch interview stages
                c.execute("SELECT * FROM candidate_interviews WHERE candidate_id = %s", (cand['candidate_id'],))
                interviews = c.fetchall()

                for iv in interviews:
                    stage = iv['stage_type']
                    if stage in cand_obj:
                        cand_obj[stage]['status'] = iv['stage_status']
                        cand_obj[stage]['interviewer'] = iv['interviewer_name']
                        cand_obj[stage]['interviewDate'] = iv['interview_date'].strftime('%Y-%m-%dT%H:%M') if iv['interview_date'] else None

                        if iv['stage_status'] == 'completed':
                            c.execute("SELECT * FROM interview_feedback WHERE interview_id = %s", (iv['interview_id'],))
                            fb = c.fetchone()
                            if fb:
                                cand_obj[stage]['feedback'] = {
                                    "date": fb['feedback_date'].strftime('%Y-%m-%d') if fb['feedback_date'] else None,
                                    "round": fb['round_name'],
                                    "interviewer": iv['interviewer_name'],
                                    "technical": fb['technical_score'],
                                    "communication": fb['communication_score'],
                                    "problemSolving": fb['problem_solving_score'],
                                    "cultureFit": fb['culture_fit_score'],
                                    "recommendation": fb['recommendation'],
                                    "comments": fb['comments']
                                }
                
                groups[jcode]['candidates'].append(cand_obj)
                
            grouped_data = list(groups.values())
    finally:
        conn.close()
        
    return jsonify(grouped_data)


@app.route('/api/add_candidate', methods=['POST'])
def add_candidate():
    """Manually add a candidate and upload their resume."""
    if 'resume' not in request.files:
        return jsonify({"error": "No resume file uploaded"}), 400
        
    file = request.files['resume']
    job_code = request.form.get('job_code')
    candidate_name = request.form.get('candidate_name')
    
    if file.filename == '':
        return jsonify({"error": "No selected file"}), 400
        
    if file and file.filename.endswith('.pdf'):
        filename = secure_filename(file.filename)
        # Create unique filename
        timestamp = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
        unique_filename = f"manual_{timestamp}_{filename}" 
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], unique_filename)
        file.save(filepath)
        db_path = f"/{filepath}" 
        
        conn = get_db_connection()
        try:
            with conn.cursor() as c:
                # Get role from summary for consistency
                c.execute("SELECT position FROM summary WHERE generated_code=%s", (job_code,))
                role_row = c.fetchone()
                role = role_row['position'] if role_row else 'Candidate'
                
                c.execute('''INSERT INTO candidate_mast (job_code, candidate_name, candidate_role, applied_date, resume_path) 
                             VALUES (%s, %s, %s, %s, %s)''', 
                          (job_code, candidate_name, role, datetime.date.today(), db_path))
            conn.commit()
        finally:
            conn.close()
            
        return jsonify({"status": "success", "message": "Candidate added successfully"})
        
    return jsonify({"error": "Invalid file format. Please upload a PDF."}), 400


@app.route('/api/sync_emails', methods=['POST'])
def sync_emails():
    """Read unread emails, extract resumes, map by Job ID subject, and save to database."""
    conn = get_db_connection()
    try:
        # 1. Fetch valid job codes to check against email subjects
        with conn.cursor() as c:
            c.execute("SELECT generated_code, position FROM summary")
            valid_jobs = {row['generated_code']: row['position'] for row in c.fetchall()}

        mail = imaplib.IMAP4_SSL(IMAP_SERVER)
        mail.login(EMAIL_ACCOUNT, EMAIL_APP_PASSWORD)
        mail.select("inbox")

        # Search for UNSEEN emails
        status, messages = mail.search(None, '(UNSEEN)')
        email_ids = messages[0].split()
        
        added_count = 0

        for e_id in email_ids:
            res, msg_data = mail.fetch(e_id, '(RFC822)')
            for response_part in msg_data:
                if isinstance(response_part, tuple):
                    msg = email.message_from_bytes(response_part[1])
                    
                    # Decode subject
                    subject, encoding = decode_header(msg["Subject"])[0]
                    if isinstance(subject, bytes):
                        subject = subject.decode(encoding if encoding else 'utf-8')
                    
                    # Check if any valid Job ID is in the subject
                    matched_job = None
                    for jcode in valid_jobs.keys():
                        if jcode in subject:
                            matched_job = jcode
                            break
                    
                    if not matched_job:
                        continue # Skip emails not related to a specific Job ID

                    # Extract attachment
                    for part in msg.walk():
                        if part.get_content_maintype() == 'multipart': continue
                        if part.get('Content-Disposition') is None: continue
                        
                        filename = part.get_filename()
                        if filename and filename.lower().endswith('.pdf'):
                            filename = secure_filename(filename)
                            timestamp = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
                            unique_filename = f"email_{timestamp}_{filename}"
                            filepath = os.path.join(app.config['UPLOAD_FOLDER'], unique_filename)
                            
                            # Save PDF
                            with open(filepath, 'wb') as f:
                                f.write(part.get_payload(decode=True))
                                
                            db_path = f"/{filepath}"
                            
                            # Extract name from PDF or fallback to sender's name
                            extracted_name = extract_name_from_pdf(filepath)
                            
                            # Insert into DB
                            with conn.cursor() as c:
                                c.execute('''INSERT INTO candidate_mast 
                                             (job_code, candidate_name, candidate_role, applied_date, resume_path) 
                                             VALUES (%s, %s, %s, %s, %s)''', 
                                          (matched_job, extracted_name, valid_jobs[matched_job], datetime.date.today(), db_path))
                            conn.commit()
                            added_count += 1
                            
        mail.logout()
        return jsonify({"status": "success", "message": f"Successfully synced and added {added_count} candidates."})
    except Exception as e:
        print(e)
        return jsonify({"status": "error", "message": str(e)}), 500
    finally:
        conn.close()

