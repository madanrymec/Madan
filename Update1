<script>
/* ---------------- Application State ---------------- */
let groupedCandidates = [];
const statusMeta = { "not-scheduled": { label: "Not Scheduled", cls: "not-scheduled" }, "scheduled": { label: "Scheduled", cls: "scheduled" }, "completed": { label: "Completed", cls: "completed" } };

/* ---------------- API & Data Fetching ---------------- */
async function loadCandidates() {
    try {
        const response = await fetch('/api/candidates');
        groupedCandidates = await response.json();
        populateJobCodeDropdown();
        renderTable();
    } catch (error) {
        console.error("Error loading candidates:", error);
    }
}

function populateJobCodeDropdown() {
    const sel = document.getElementById('manualJobCode');
    sel.innerHTML = '<option value="" disabled selected>Select Job to link candidate...</option>' + 
        groupedCandidates.map(g => `<option value="${g.jobCode}">${g.jobCode} - ${g.role} (${g.location})</option>`).join('');
}

/* ---------------- Manual Entry & Sync ---------------- */
function openAddCandidateModal() {
    document.getElementById('addCandidateForm').reset();
    document.getElementById('addCandidateOverlay').classList.add('open');
}

document.getElementById('addCandidateForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData();
    formData.append('job_code', document.getElementById('manualJobCode').value);
    formData.append('candidate_name', document.getElementById('manualCandidateName').value);
    formData.append('resume', document.getElementById('manualResume').files[0]);

    try {
        const response = await fetch('/api/add_candidate', { method: 'POST', body: formData });
        const result = await response.json();
        if (result.status === 'success') {
            closeModal('addCandidateOverlay');
            loadCandidates();
        } else { alert(result.error); }
    } catch (error) { console.error("Error:", error); }
});

async function syncEmails() {
    const btn = document.getElementById('syncEmailBtn');
    btn.textContent = 'Syncing...';
    try {
        const response = await fetch('/api/sync_emails', { method: 'POST' });
        const result = await response.json();
        alert(result.message);
        loadCandidates();
    } catch (error) {
        console.error("Sync error:", error);
        alert("Failed to sync emails.");
    }
    btn.textContent = 'Sync Email Resumes ↻';
}


/* ---------------- Rendering Logic ---------------- */
function finalOutcome(c){
  const hrDone = c.hr.status === 'completed';
  const techDone = c.tech.status === 'completed';
  if(hrDone && c.hr.feedback?.recommendation === 'reject') return { label: 'Rejected', cls: 'rejected' };
  if(techDone && c.tech.feedback?.recommendation === 'reject') return { label: 'Rejected', cls: 'rejected' };
  if(hrDone && techDone){
    const both = [c.hr.feedback?.recommendation, c.tech.feedback?.recommendation];
    if(both.includes('hold')) return { label: 'On Hold', cls: 'hold' };
    return { label: 'Selected', cls: 'selected' };
  }
  if(hrDone || techDone) return { label: 'In Progress', cls: 'pending' };
  return { label: 'Pending', cls: 'pending' };
}

function stageCellHtml(c, stage){
  const s = c[stage] || {status: 'not-scheduled'};
  const sMeta = statusMeta[s.status] || statusMeta['not-scheduled'];
  
  let html = `<div class="stage-cell">`;
  html += `<span class="badge ${sMeta.cls}">${sMeta.label}</span>`;
  
  if(s.status === 'scheduled' && s.interviewDate){
    const dt = new Date(s.interviewDate);
    html += `<div class="stage-date">${dt.toLocaleString([], {dateStyle: 'medium', timeStyle: 'short'})}</div>`;
  }
  html += `</div>`;
  return html;
}

function renderTable(){
  let totalCands = 0, hrDone = 0, techDone = 0, selCount = 0, pendCount = 0;
  let html = "";

  groupedCandidates.forEach(group => {
      // Create Sub-Table Header for Job ID
      html += `
        <tr class="job-group-header">
            <td colspan="6">
                <span class="job-group-title">Job ID: ${group.jobCode}</span>
                <span class="job-group-meta">Role: ${group.role} | Location: ${group.location}</span>
            </td>
        </tr>
      `;

      group.candidates.forEach(c => {
          totalCands++;
          if(c.hr.status === 'completed') hrDone++;
          if(c.tech.status === 'completed') techDone++;
          
          const outcome = finalOutcome(c);
          if(outcome.label === 'Selected') selCount++;
          if(c.hr.status !== 'completed' || c.tech.status !== 'completed') pendCount++;

          const appliedStr = c.appliedOn ? new Date(c.appliedOn).toLocaleDateString([], {dateStyle:'medium'}) : '—';
          
          html += `
          <tr>
            <td>
              <div class="candidate-name">${c.name}</div>
            </td>
            <td><span class="applied-date">${appliedStr}</span></td>
            <td>
              <button class="btn-ghost" onclick="openResume('${c.resumeFile}', '${c.name}')">View PDF</button>
            </td>
            <td class="stage-col">${stageCellHtml(c, 'hr')}</td>
            <td class="stage-col">${stageCellHtml(c, 'tech')}</td>
            <td style="text-align:center;"><span class="badge ${outcome.cls}">${outcome.label}</span></td>
          </tr>
          `;
      });
  });

  document.getElementById('candidateRows').innerHTML = html;

  // Update Top Stats
  document.getElementById('statsRow').innerHTML = `
    <div class="stat"><div class="n">${totalCands}</div><div class="l">Total applicants</div></div>
    <div class="stat"><div class="n">${hrDone}</div><div class="l">HR interviews completed</div></div>
    <div class="stat"><div class="n">${techDone}</div><div class="l">Technical interviews completed</div></div>
    <div class="stat"><div class="n">${selCount}</div><div class="l">Selected</div></div>
    <div class="stat"><div class="n">${pendCount}</div><div class="l">Awaiting a stage</div></div>
  `;
}

function openResume(filepath, name){
  if (!filepath || filepath === 'None') { alert("No resume file available."); return; }
  document.getElementById('pdfModalName').textContent = `${name} — Resume`;
  document.getElementById('pdfFrame').src = filepath; 
  document.getElementById('pdfOverlay').classList.add('open');
}

function closeModal(id){
  document.getElementById(id).classList.remove('open');
  if(id === 'pdfOverlay') document.getElementById('pdfFrame').src = '';
}

document.querySelectorAll('.modal-overlay').forEach(ov => {
  ov.addEventListener('click', (e) => { if(e.target === ov) closeModal(ov.id); });
});

document.addEventListener("DOMContentLoaded", loadCandidates);
</script>
</body>
</html>
