Here is the complete solution for adding the **Candidate Email** field, generating dynamic **4-Stage Email Templates** (along with their rejection counterparts), and building a **Preview & Edit Modal** so you can review and tweak the email before sending it out.

### 1. Database Update (`summary` & `candidate_mast`)

Ensure you add a `candidate_email` column to your `candidate_mast` table so that we can save and retrieve the candidate's email address:

```sql
ALTER TABLE candidate_mast ADD COLUMN candidate_email VARCHAR(255) AFTER candidate_name;

```

---

### 2. Python Backend (`app.py`)

We need a helper function to generate the email bodies, an API endpoint to **preview** the email, and an API endpoint to **send** the email using Python's standard `smtplib` library.

```python
import smtplib
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart

def get_email_template(template_type, cand_name, role, hr_date=None, tech_date=None):
    """Returns Default Email Subject and Body for the 4 stages + rejection."""
    templates = {
        "hr_schedule": {
            "subject": f"Interview Invitation: HR Screening for {role}",
            "body": f"""Dear {cand_name},

Thank you for applying for the {role} position. We were impressed with your profile and would like to invite you for an HR Screening round.

Scheduled Date & Time: {hr_date or 'To be confirmed'}
Mode: Online / In-Person (Details to follow)

Please reply to this email to confirm your availability.

Best regards,
Recruitment Team"""
        },
        "hr_select": {
            "subject": f"Update on your application for {role} - HR Screening Cleared",
            "body": f"""Dear {cand_name},

We are pleased to inform you that you have successfully cleared the HR Screening round for the {role} position!

Our team will reach out to you shortly with the schedule for your Technical Interview round.

Best regards,
Recruitment Team"""
        },
        "tech_schedule": {
            "subject": f"Interview Invitation: Technical Round for {role}",
            "body": f"""Dear {cand_name},

Congratulations on clearing the initial screening! We would like to invite you for the Technical Interview round for the {role} position.

Scheduled Date & Time: {tech_date or 'To be confirmed'}
Mode: Online / In-Person (Details to follow)

Please confirm your availability by replying to this email.

Best regards,
Recruitment Team"""
        },
        "tech_select": {
            "subject": f"Congratulations! Offer / Selection for {role}",
            "body": f"""Dear {cand_name},

We are thrilled to inform you that you have cleared the Technical Interview and have been selected for the {role} position!

Our HR team will get in touch with you shortly regarding the next steps and documentation.

Welcome aboard!

Best regards,
Recruitment Team"""
        },
        "reject": {
            "subject": f"Update on your application for {role}",
            "body": f"""Dear {cand_name},

Thank you for giving us the opportunity to consider your application for the {role} position.

After careful consideration, we have decided to move forward with other candidates whose qualifications more closely match our current requirements. We appreciate your time and wish you the very best in your career endeavors.

Best regards,
Recruitment Team"""
        }
    }
    return templates.get(template_type, {"subject": "", "body": ""})


@app.route('/api/email/preview', methods=['POST'])
def preview_email():
    """Generates the email subject and body for frontend editing."""
    data = request.json
    template_type = data.get('template_type') # hr_schedule, hr_select, tech_schedule, tech_select, reject
    cand_name = data.get('candidate_name', 'Candidate')
    role = data.get('role', 'Position')
    date_str = data.get('schedule_date', '')

    template = get_email_template(
        template_type, 
        cand_name, 
        role, 
        hr_date=date_str if 'hr' in template_type else None,
        tech_date=date_str if 'tech' in template_type else None
    )

    # Get logged-in user's email as the 'From' address
    from_email = "recruitment@company.com" # Fallback
    if 'emp_id' in session:
        conn = get_user_db_connection()
        try:
            with conn.cursor() as c:
                c.execute("SELECT emp_email FROM user_mast WHERE emp_id = %s", (session['emp_id'],))
                res = c.fetchone()
                if res and res.get('emp_email'):
                    from_email = res['emp_email']
        finally:
            conn.close()

    return jsonify({
        "from_email": from_email,
        "subject": template["subject"],
        "body": template["body"]
    })


@app.route('/api/email/send', methods=['POST'])
def send_email():
    """Sends the edited email to the candidate."""
    data = request.json
    to_email = data.get('to_email')
    from_email = data.get('from_email')
    subject = data.get('subject')
    body = data.get('body')

    if not to_email:
        return jsonify({"status": "error", "message": "Candidate email is required."}), 400

    try:
        # --- SMTP Configuration ---
        # Update these with your real SMTP server settings
        SMTP_SERVER = "smtp.gmail.com"
        SMTP_PORT = 587
        SMTP_USER = "your_email_account@gmail.com"
        SMTP_PASSWORD = "your_app_password"

        msg = MIMEMultipart()
        msg['From'] = from_email
        msg['To'] = to_email
        msg['Subject'] = subject
        msg.attach(MIMEText(body, 'plain'))

        with smtplib.SMTP(SMTP_SERVER, SMTP_PORT) as server:
            server.starttls()
            server.login(SMTP_USER, SMTP_PASSWORD)
            server.send_message(msg)

        return jsonify({"status": "success", "message": "Email sent successfully!"})
    except Exception as e:
        print(f"Error sending email: {e}")
        return jsonify({"status": "error", "message": f"Failed to send email: {str(e)}"}), 500

