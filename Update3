### 4. Frontend JavaScript Functions

Add these functions to your script block. When you click **"Schedule"** or **"Add Feedback"**, you can now trigger `openEmailPreview(...)` to load the template, let the user edit it, and send it out.

```javascript
/* ---------------- Email Preview & Send Logic ---------------- */

async function openEmailPreview(candidateId, templateType, scheduleDate = "") {
  const c = getCandidateById(candidateId);
  if (!c) return;

  try {
    const response = await fetch('/api/email/preview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        template_type: templateType,
        candidate_name: c.name,
        role: c.role,
        schedule_date: scheduleDate
      })
    });

    const data = await response.json();

    // Populate Modal Fields
    document.getElementById('emailFrom').value = data.from_email;
    document.getElementById('emailTo').value = c.email || ""; // Pre-fill if email exists
    document.getElementById('emailSubject').value = data.subject;
    document.getElementById('emailBody').value = data.body;

    // Show Modal
    document.getElementById('emailOverlay').style.display = 'block';

  } catch (error) {
    console.error("Error generating email preview:", error);
    alert("Could not load email template.");
  }
}

function closeEmailModal() {
  document.getElementById('emailOverlay').style.display = 'none';
}

async function sendFinalEmail() {
  const btn = document.getElementById('sendEmailBtn');
  btn.disabled = true;
  btn.textContent = "Sending...";

  const payload = {
    from_email: document.getElementById('emailFrom').value,
    to_email: document.getElementById('emailTo').value,
    subject: document.getElementById('emailSubject').value,
    body: document.getElementById('emailBody').value
  };

  try {
    const response = await fetch('/api/email/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await response.json();
    if (result.status === "success") {
      alert("Email sent successfully!");
      closeEmailModal();
    } else {
      alert("Error: " + result.message);
    }
  } catch (error) {
    console.error("Error sending email:", error);
    alert("An error occurred while sending the email.");
  } finally {
    btn.disabled = false;
    btn.textContent = "Send Email";
  }
}

```

### How to use this in your Workflow:

You can call `openEmailPreview(candidateId, templateType)` directly from your existing buttons or inside your Feedback modal:

* **HR Schedule:** `openEmailPreview(id, 'hr_schedule', '2026-08-05 10:00 AM')`
* **HR Cleared:** `openEmailPreview(id, 'hr_select')`
* **Tech Schedule:** `openEmailPreview(id, 'tech_schedule', '2026-08-10 02:00 PM')`
* **Tech Selected:** `openEmailPreview(id, 'tech_select')`
* **Rejection (Any Round):** `openEmailPreview(id, 'reject')`
