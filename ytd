    function adjustYTDTargets(percent) {
    const factor = 1 + (parseInt(percent) / 100);

    // 1. Update Slider Label UI
    const label = document.getElementById('ytd-range-value');
    label.textContent = (percent > 0 ? "+" : "") + percent + "%";
    const currencyFormatter = new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
    });
    // 2. Update KPI Card & Gauge
    const newTarget = originalYTD_KPI.target * factor ;
    const newTargetDisplay = originalYTD_KPI.target * factor * 100000;
    const newPercent = (originalYTD_KPI.actual / newTarget) * 100;

    document.getElementById('ytd-target').innerText = currencyFormatter.format(newTargetDisplay);
    renderAchievementGauge(newPercent, newTarget, originalYTD_KPI.actual);

    // 3. Update Product Chart
    if (charts.product) {
        // Update the Target Gap dataset
        charts.product.data.datasets[1].data = originalYTD_Prod.targets.map((t, i) => {
            const adjustedT = t * factor;
            const actual = originalYTD_Prod.actuals[i] || 0;
            return adjustedT > actual ? adjustedT - actual : 0;
        });

        // Update Tooltips/Datalabels formatter dynamically
        charts.product.options.plugins.datalabels.formatter = (value, ctx) => {
            const i = ctx.dataIndex;
            const actual = originalYTD_Prod.actuals[i];
            const target = originalYTD_Prod.targets[i] * factor;
            const pct = target > 0 ? Math.round((actual / target) * 100) : 0;
            return `${pct}%\n${Math.round(actual)} L`;
        };

        charts.product.update('none');
    }

    // 4. Update Region Chart
    if (charts.region) {
        charts.region.data.datasets[1].data = originalYTD_Reg.targets.map((t, i) => {
            const adjustedT = t * factor;
            const actual = originalYTD_Reg.actuals[i] || 0;
            return adjustedT > actual ? adjustedT - actual : 0;
        });

        charts.region.options.plugins.datalabels.formatter = (value, context) => {
            const i = context.dataIndex;
            const actual = originalYTD_Reg.actuals[i];
            const target = originalYTD_Reg.targets[i] * factor;
            const pct = target > 0 ? Math.round((actual / target) * 100) : 0;
            return actual > 0 ? `${Math.round(actual)}L (${pct}%)` : '';
        };

        charts.region.update('none');
    }
}

