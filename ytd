            ctx.textBaseline = 'middle';

            if(mediaQuery.matches == true){
                ctx.font = 'bold 8px Arial'; ctx.fillStyle = '#333';
                }
                else{
                ctx.font = 'bold 12px Arial'; ctx.fillStyle = '#333';
                }
            ctx.fillText(fullName, textX, y2 - 8);

            ctx.font = 'bold 11px Arial';
            ctx.fillStyle = '#666';
            ctx.fillText(`${pct}`, textX, y2 + 8);

            ctx.restore();
        });
    }
};

