function renderKPIGauge(percent, target, actual) {
    const ctx = document.getElementById('salesAchievedGauge').getContext('2d');
    const val = Math.min(Math.max(parseFloat(percent) || 0, 0), 100);
    const targetVal = parseFloat(target) || 0;
    const actualLabel = actual ? Number(actual).toFixed(2) + " L" : "0 L";

    const activeSegmentIndex = Math.min(Math.floor(val / 10), 9);
    const dataValue = Array(10).fill("");
    dataValue[activeSegmentIndex] = actualLabel;

    if(charts.gauge) charts.gauge.destroy();

    const centerTextPlugin = {
        id: 'centerText',
        afterDraw(chart) {
            const { ctx, chartArea: { width, height } } = chart;
            ctx.save();
            // Move to center of the chart
            const cx = width / 2;
            const cy = chart._metasets[0].data[0].y;

            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            if(mediaQuery.matches == true){
               ctx.font = 'bold 15px Arial';
            }else{
               ctx.font = 'bold 24px Arial';
            }

            ctx.fillStyle = '#333';

            // Adjust the 35px downward so it sits below the needle base
            ctx.fillText(val.toFixed(0) + '%', cx, cy + 35);
            ctx.restore();
        }
    };

    // --- Plugin: 0 and Target at Ends ---
    const gaugeLabels = {
        id: 'gaugeLabels',
        afterDatasetsDraw(chart) {
            const { ctx } = chart;
            const meta = chart.getDatasetMeta(0);
            const x = meta.data[0].x;
            const y = meta.data[0].y;
            const outerRadius = meta.data[0].outerRadius;

            ctx.save();
            if(mediaQuery.matches == true){
            ctx.font = 'bold 7px Arial';
            ctx.textAlign = 'center';
            }else{
                ctx.font = 'bold 11px Arial';
                ctx.textAlign = 'center';
            }
            ctx.fillStyle = '#666';


            ctx.fillText('0', x - outerRadius + 5, y + 15);
            if(mediaQuery.matches == true){
               ctx.fillText(targetVal.toLocaleString() + ' L', x + outerRadius - 14, y + 15);
            }else{
                ctx.fillText(targetVal.toLocaleString() + ' L', x + outerRadius - 20, y + 15);
            }
            ctx.restore();
        }
    };

    // --- Plugin: Needle ---
    const needlePlugin = {
        id: 'needle',
        afterDatasetDraw(chart) {
            const { ctx, chartArea: { width, height } } = chart;
            ctx.save();

            const cx = width / 2;
            const cy = chart._metasets[0].data[0].y;  // usually near bottom of arc

            const angle = Math.PI + (val / 100) * Math.PI;
            const needleLength = height * 0.50;

            var needleWidth=0;
            var baseRadius=0;
            // Needle properties — feel free to tune
            if(mediaQuery.matches == true){
             needleWidth  = 8;
             baseRadius   = 8;
            }else{
             needleWidth  = 10;
             baseRadius   = 10;
            }


            // Draw needle triangle
            ctx.translate(cx, cy);
            ctx.rotate(angle);
            ctx.beginPath();
            ctx.moveTo(0, -needleWidth / 2);
            ctx.lineTo(needleLength, 0);
            ctx.lineTo(0, needleWidth / 2);
            ctx.closePath();

            // Needle fill + shadow
            ctx.fillStyle = '#2c3e50';     // dark gray / blackish
            ctx.shadowColor = 'rgba(0,0,0,0.4)';
            ctx.shadowBlur = 8;
            ctx.shadowOffsetX = 3;
            ctx.shadowOffsetY = 3;
            ctx.fill();

