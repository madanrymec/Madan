window.applySectorFilter = async function() {
    if (typeof showLoader === 'function') showLoader();

    const params = new URLSearchParams();
    const yearElement = document.getElementById('fin-year-select');
    const yearValue = yearElement ? yearElement.value : null;

    if (!yearValue) {
        console.error("Year element not found or value empty. Check if ID 'fin_year_select' exists.");
        if (typeof hideLoader === 'function') hideLoader();
        alert("Please select a Financial Year first.");
        return; // Stop here if no year is found
    }

    params.append('fin_year', yearValue);
    document.querySelectorAll('.sector-prod-check:checked').forEach(cb => {
        params.append('product', cb.value);
    });


    document.querySelectorAll('.month-check:checked').forEach(cb => {
        params.append('month', cb.value);
    });

    try {

        console.log("Fetching URL:", `/api/ytd/sector?${params.toString()}`);

        const response = await fetch(`/api/ytd/sector?${params.toString()}`);
        const data = await response.json();

        if (data.error) {
            console.error("Server Error:", data.error);
            alert("Error: " + data.error);
            return;
        }

        if (sectorChartInstance && data.labels) {
            sectorChartInstance.data.labels = data.labels;
            sectorChartInstance.data.datasets[0].data = data.values;
            sectorChartInstance.update();

            document.getElementById('modal-filter-content').style.display = 'none';
        }
    } catch (e) {
        console.error("Filter Update Failed:", e);
    } finally {
        if (typeof hideLoader === 'function') hideLoader();
    }
};
