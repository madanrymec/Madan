        id: 'sectorLineConnector',
        afterDraw: (chart) => {
            const { ctx } = chart;
            const leftLabels = [], rightLabels = [];

            chart.data.datasets[0].data.forEach((value, index) => {
                const meta = chart.getDatasetMeta(0).data[index];
                if (meta.hidden) return;

                const props = meta.getProps(['x', 'y', 'startAngle', 'endAngle', 'outerRadius'], true);
                const midAngle = props.startAngle + (props.endAngle - props.startAngle) / 2;
                const isRight = Math.cos(midAngle) > 0;

                const x1 = Math.cos(midAngle) * props.outerRadius + props.x;
                const y1 = Math.sin(midAngle) * props.outerRadius + props.y;
                let x2 = Math.cos(midAngle) * (props.outerRadius + 35) + props.x;
                let y2 = Math.sin(midAngle) * (props.outerRadius + 35) + props.y;

                // Anti-overlap logic
                const sideList = isRight ? rightLabels : leftLabels;
                const minGap = 28;
                sideList.sort((a, b) => a.y - b.y);
                sideList.forEach(prev => {
                    if (Math.abs(y2 - prev.y) < minGap) {
                        y2 = y2 > prev.y ? prev.y + minGap : prev.y - minGap;
                    }
                });
                sideList.push({ y: y2 });

                const x3 = x2 + (isRight ? 20 : -20);
                ctx.save();
                ctx.strokeStyle = '#999';
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.lineTo(x3, y2); ctx.stroke();
