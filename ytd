    id: 'highResLineConnector',
    afterDraw: (chart) => {
        const { ctx, chartArea } = chart;
        const leftSide = [];
        const rightSide = [];

        // Pass 1: Collect all data and determine sides
        chart.data.datasets[0].data.forEach((value, index) => {
            const meta = chart.getDatasetMeta(0).data[index];
            if (meta.hidden) return;

            const props = meta.getProps(['x', 'y', 'startAngle', 'endAngle', 'outerRadius'], true);
            const midAngle = props.startAngle + (props.endAngle - props.startAngle) / 2;
            const isRight = Math.cos(midAngle) > 0;

            const x1 = Math.cos(midAngle) * props.outerRadius + props.x;
            const y1 = Math.sin(midAngle) * props.outerRadius + props.y;

            // Initial elbow position
            const x2_init = Math.cos(midAngle) * (props.outerRadius + 35) + props.x;
            const y2_init = Math.sin(midAngle) * (props.outerRadius + 35) + props.y;

            const info = {
                x1, y1, x2_init, y2_init,
                isRight, index, value,
                midAngle,
                y_final: y2_init // Will be adjusted
            };

            if (isRight) rightSide.push(info);
            else leftSide.push(info);
        });

        // Pass 2: Vertical Collision Resolution (Bi-directional)
        const resolveVerticalSpace = (sideList) => {
            if (sideList.length === 0) return;
            const minGap = 32; // Optimized for 12px font + 2 lines of text

            // Sort by natural vertical position
            sideList.sort((a, b) => a.y2_init - b.y2_init);

            // Forward push
            for (let i = 1; i < sideList.length; i++) {
                if (sideList[i].y_final - sideList[i-1].y_final < minGap) {
                    sideList[i].y_final = sideList[i-1].y_final + minGap;
                }
            }
            // Backward push (balance the distribution)
            for (let i = sideList.length - 2; i >= 0; i--) {
                if (sideList[i+1].y_final - sideList[i].y_final < minGap) {
                    sideList[i].y_final = sideList[i+1].y_final - minGap;
                }
            }
        };

        resolveVerticalSpace(leftSide);
        resolveVerticalSpace(rightSide);

        // Pass 3: Drawing
        const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
        const map = { 'DD': 'Domestic Direct', 'DE':'Dealers','DX':'Deemed Export','EX':'Export' };

        [...leftSide, ...rightSide].forEach(item => {
