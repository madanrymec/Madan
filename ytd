function adjustDailyTargets(percent) {
    const factor = 1 + (parseInt(percent) / 100);

    // Update Slider Label
    const label = document.getElementById('daily-range-value');
    label.textContent = (percent > 0 ? "+" : "") + percent + "%";

    // 1. Update KPI & Gauge
     const currencyFormatter = new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
    });
    const newTarget = originalDailyKPI.target * factor;
    const newTargetDisplay = originalDailyKPI.target * factor * 100000;
    const newPercent = (originalDailyKPI.actual / newTarget) * 100;

    document.getElementById('kpi-target').textContent = currencyFormatter.format(newTargetDisplay);
    renderKPIGauge(newPercent, newTarget, originalDailyKPI.actual);

    // 2. Update Product Chart
    if (charts.product) {
        // Update Target Gap Data
        charts.product.data.datasets[1].data = originalDailyProd.targets.map((t, i) => {
            const adjT = t * factor;
            const act = originalDailyProd.actuals[i] || 0;
            return adjT > act ? adjT - act : 0;
        });

        // Update Datalabels Formatter to reflect new %
        charts.product.options.plugins.datalabels.formatter = (value, context) => {
            const i = context.dataIndex;
            const actual = originalDailyProd.actuals[i];
            const target = originalDailyProd.targets[i] * factor;
            const pct = target > 0 ? Math.round((actual / target) * 100) : 0;
            return context.datasetIndex === 1 ? `${pct}% \n ${Math.round(actual)}L` : null;
        };
        charts.product.update('none');
    }

    // 3. Update Region Chart
    if (charts.region) {
        charts.region.data.datasets[1].data = originalDailyReg.targets.map((t, i) => {
            const adjT = t * factor;
            const act = originalDailyReg.actuals[i] || 0;
            return adjT > act ? adjT - act : 0;
        });

        charts.region.options.plugins.datalabels.formatter = (value, context) => {
            const i = context.dataIndex;
            const actual = originalDailyReg.actuals[i];
            const target = originalDailyReg.targets[i] * factor;
            const pct = target > 0 ? Math.round((actual / target) * 100) : 0;
            return actual > 0 ? `${Math.round(actual)}L (${pct}%)` : '';
        };
        charts.region.update('none');
    }
}

