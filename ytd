            const x2 = x2_init;
            const y2 = y_final;
            const x3 = x2 + (isRight ? 20 : -20);

            // Draw Lines
            ctx.save();
            ctx.strokeStyle = '#999';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.lineTo(x3, y2);
            ctx.stroke();

