const trendLinePlugin = {
    id: 'trendLineConnector',
    afterDraw: (chart) => {
        const { ctx } = chart;
        const leftLabels = [];
        const rightLabels = [];

        chart.data.datasets.forEach((dataset, i) => {
            const meta = chart.getDatasetMeta(i);
            meta.data.forEach((datapoint, index) => {
                if (datapoint.hidden) return;

                const props = datapoint.getProps(['x', 'y', 'startAngle', 'endAngle', 'outerRadius'], true);
                const midAngle = props.startAngle + (props.endAngle - props.startAngle) / 2;
                const isRight = Math.cos(midAngle) > 0;

                // Points calculation
                const x1 = Math.cos(midAngle) * props.outerRadius + props.x;
                const y1 = Math.sin(midAngle) * props.outerRadius + props.y;

                let x2 = Math.cos(midAngle) * (props.outerRadius + 30) + props.x;
                let y2 = Math.sin(midAngle) * (props.outerRadius + 30) + props.y;

                // --- STAGGERING LOGIC ---
                const sideList = isRight ? rightLabels : leftLabels;
                const minGap = 26; // Vertical gap to prevent overlap

                sideList.sort((a, b) => a.y - b.y);
                sideList.forEach(prev => {
                    if (Math.abs(y2 - prev.y) < minGap) {
                        y2 = y2 > prev.y ? prev.y + minGap : prev.y - minGap;
                    }
                });
                sideList.push({ y: y2 });

                const x3 = x2 + (isRight ? 20 : -20);

                // Draw the Connector Line
                ctx.save();
                ctx.strokeStyle = '#999';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
