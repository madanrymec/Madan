            <label>Candidate Source</label>
            <select id="manualSource" required onchange="toggleSourceInput()">
                <option value="" disabled selected>Select source...</option>
                <option value="LinkedIn">LinkedIn</option>
                <option value="Naukri">Naukri</option>
                <option value="Indeed">Indeed</option>
                <option value="Referral">Referral</option>
                <option value="Others">Others</option>
            </select>
        </div>

        <!-- Hidden input that shows only for Referral or Others -->
        <div class="ff-field" id="extraSourceDiv" style="display: none;">
            <label id="extraSourceLabel">Specify Details</label>
            <input type="text" id="manualSourceDetails" placeholder="">
        </div>
        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
            <button type="button" class="btn-cancel" onclick="closeModal('addCandidateOverlay')">Cancel</button>
            <button type="submit" class="btn-save">Save Candidate</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- PDF Modal -->
<div class="modal-overlay" id="pdfOverlay">
  <div class="modal wide">
    <div class="modal-head">
      <div>
        <div class="modal-title" id="pdfModalName">Resume</div>
        <div class="modal-sub" id="pdfModalSub"></div>
      </div>
      <button class="modal-close" onclick="closeModal('pdfOverlay')">✕</button>
    </div>
    <div class="modal-body">
      <iframe class="pdf-frame" id="pdfFrame" src=""></iframe>
    </div>
  </div>
</div>

<!-- Feedback & Schedule Modal -->
<div class="modal-overlay" id="fbOverlay">
  <div class="modal">
    <div class="modal-head">
      <div>
        <div class="modal-title" id="fbModalTitle">Interview Feedback</div>
        <div class="modal-sub" id="fbModalSub"></div>
      </div>
      <button class="modal-close" onclick="closeModal('fbOverlay')">✕</button>
    </div>
    <div class="modal-body" id="fbModalBody"></div>
  </div>
</div>

<script>
/* ---------------- Application State ---------------- */
let candidates = [];
const STAGES = ['hr', 'tech'];
const stageLabel = { hr: 'HR', tech: 'Technical' };

const statusMeta = {
  "not-scheduled": { label: "Not Scheduled", cls: "not-scheduled" },
  "scheduled": { label: "Scheduled", cls: "scheduled" },
  "completed": { label: "Completed", cls: "completed" },
};

const recMeta = {
  strongly: { label: "Strong Yes", cls: "selected" },
  recommend: { label: "Yes", cls: "selected" },
  hold: { label: "Hold", cls: "hold" },
  reject: { label: "No", cls: "rejected" },
};

/* ---------------- API & Data Fetching ---------------- */
async function loadCandidates() {
    try {
        const response = await fetch('/api/candidates');
        candidates = await response.json();

        populateJobCodeDropdown();
        renderTable();
    } catch (error) {
        console.error("Error loading candidates:", error);
    }
}

function populateJobCodeDropdown() {
    // Group unique jobs to populate dropdowns
    const uniqueJobs = Array.from(new Map(candidates.map(c => [c.jobCode, c])).values());

    // 1. Populate the manual form dropdown
    const sel = document.getElementById('manualJobCode');
    sel.innerHTML = '<option value="" disabled selected>Select Job to link candidate...</option>' +
        uniqueJobs.map(j => `<option value="${j.jobCode}">${j.jobCode} - ${j.role} (${j.location})</option>`).join('');

    // 2. Populate the top table filter
    const filterSel = document.getElementById('jobCodeFilter');
    // Save current selection to restore it after repopulating
    const currentVal = filterSel.value;

    filterSel.innerHTML = '<option value="all">All Job Codes</option>' +
        uniqueJobs.map(j => `<option value="${j.jobCode}">${j.jobCode}</option>`).join('');

    if (currentVal && filterSel.querySelector(`option[value="${currentVal}"]`)) {
        filterSel.value = currentVal;
    }

    // Ensure event listener is added (or re-added)
    filterSel.removeEventListener('change', renderTable);
    filterSel.addEventListener('change', renderTable);
}

function currentFilter(){ return document.getElementById('jobCodeFilter').value || 'all'; }

/* ---------------- Manual Entry & Sync ---------------- */
function handleTableSourceChange(candId) {
    const selectElem = document.getElementById(`source-select-${candId}`);
    const extraInput = document.getElementById(`source-extra-${candId}`);
    const val = selectElem.value;

    if (val === 'Referral' || val === 'Others') {
        extraInput.style.display = 'block';
        extraInput.placeholder = val === 'Referral' ? 'Referrer name...' : 'Specify source...';
        extraInput.focus();
    } else {
        extraInput.style.display = 'none';
        extraInput.value = '';
        saveTableSource(candId); // Save immediately for standard options
    }
}

async function saveTableSource(candId) {
    const selectElem = document.getElementById(`source-select-${candId}`);
    if (!selectElem) return;

    const finalSource = selectElem.value;

    try {
        const response = await fetch('/api/update_source', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ candidate_id: candId, source: finalSource })
        });
        const result = await response.json();

        if (result.status === 'success') {
            const c = getCandidateById(candId);
            if (c) c.source = finalSource; // Update local memory quietly
        }
    } catch (error) {
        console.error("Failed to update source:", error);
    }
}
function openAddCandidateModal() {
    document.getElementById('addCandidateForm').reset();
    document.getElementById('addCandidateOverlay').classList.add('open');
}
function toggleSourceInput() {
    const source = document.getElementById('manualSource').value;
    const extraDiv = document.getElementById('extraSourceDiv');
    const extraLabel = document.getElementById('extraSourceLabel');
    const extraInput = document.getElementById('manualSourceDetails');

    if (source === 'Referral') {
        extraDiv.style.display = 'flex';
        extraLabel.textContent = 'Referrer Name';
        extraInput.placeholder = 'Enter employee name...';
        extraInput.required = true;
    } else if (source === 'Others') {
        extraDiv.style.display = 'flex';
        extraLabel.textContent = 'Specify Source';
        extraInput.placeholder = 'e.g., Campus Drive, Walk-in...';
        extraInput.required = true;
    } else {
        extraDiv.style.display = 'none';
        extraInput.required = false;
        extraInput.value = '';
    }
}

document.getElementById('addCandidateForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData();
    formData.append('job_code', document.getElementById('manualJobCode').value);
    formData.append('candidate_name', document.getElementById('manualCandidateName').value);
    formData.append('resume', document.getElementById('manualResume').files[0]);

    let finalSource = document.getElementById('manualSource').value;
    if (finalSource === 'Referral' || finalSource === 'Others') {
        const extraDetails = document.getElementById('manualSourceDetails').value;
        finalSource = `${finalSource} - ${extraDetails}`;
    }
    formData.append('candidate_source', finalSource);

    try {
        const response = await fetch('/api/add_candidate', { method: 'POST', body: formData });
        const result = await response.json();
        if (result.status === 'success') {
            closeModal('addCandidateOverlay');
            loadCandidates();
        } else { alert(result.error); }
    } catch (error) { console.error("Error:", error); }
});

async function syncEmails() {
    const btn = document.getElementById('syncEmailBtn');
    const originalText = btn.textContent;
    btn.textContent = 'Syncing...';
    try {
        const response = await fetch('/api/sync_emails', { method: 'POST' });
        const result = await response.json();
        alert(result.message);
        loadCandidates();
    } catch (error) {
        console.error("Sync error:", error);
        alert("Failed to sync emails.");
    }
    btn.textContent = originalText;
}

/* ---------------- Rendering Logic ---------------- */
function finalOutcome(c){
  const hrDone = c.hr.status === 'completed' && c.hr.feedback;
  const techDone = c.tech.status === 'completed' && c.tech.feedback;

  if(hrDone && c.hr.feedback.recommendation === 'reject') return { label: 'Rejected', cls: 'rejected' };
  if(techDone && c.tech.feedback.recommendation === 'reject') return { label: 'Rejected', cls: 'rejected' };

  if(hrDone && techDone){
    const both = [c.hr.feedback.recommendation, c.tech.feedback.recommendation];
    if(both.includes('hold')) return { label: 'On Hold', cls: 'hold' };
    return { label: 'Selected', cls: 'selected' };
  }
  if(hrDone || techDone) return { label: 'In Progress', cls: 'pending' };
  return { label: 'Pending', cls: 'pending' };
}

function stageCellHtml(c, stage){
  const s = c[stage] || {status: 'not-scheduled'};
  const sMeta = statusMeta[s.status] || statusMeta['not-scheduled'];

  let html = `<div class="stage-cell">`;
  html += `<span class="badge ${sMeta.cls}">${sMeta.label}</span>`;

  if(s.status === 'scheduled' && s.interviewDate){
    const dt = new Date(s.interviewDate);
    html += `<div class="stage-date">${dt.toLocaleString([], {dateStyle: 'medium', timeStyle: 'short'})}</div>`;
  }

  html += `<div class="stage-interviewer">${s.interviewer ? s.interviewer : '<span class="muted">Unassigned</span>'}</div>`;

  if(s.feedback){
    const rMeta = recMeta[s.feedback.recommendation];
    html += `<span class="badge ${rMeta.cls}">${rMeta.label}</span>`;
    html += `<button class="feedback-btn secondary" onclick="openFeedback(${c.id}, '${stage}')">View feedback</button>`;
  } else if(s.status === 'not-scheduled') {
    html += `<button class="feedback-btn secondary" onclick="openFeedback(${c.id}, '${stage}')">Schedule &amp; add feedback</button>`;
  } else {
    html += `<button class="feedback-btn" onclick="openFeedback(${c.id}, '${stage}')">Add feedback</button>`;
  }
  html += `</div>`;
  return html;
}


/* ---------------- Rendering & Accordion Logic ---------------- */
function renderTable() {
  let totalCands = 0, hrDone = 0, techDone = 0, selCount = 0, pendCount = 0;
  let html = "";

  const filter = currentFilter();
  // Filter jobs based on dropdown
  const filteredJobs = candidates.filter(job => filter === 'all' || job.jobCode === filter);

  filteredJobs.forEach(job => {
      const candCount = job.candidates.length;

      // 1. The Main Clickable Job Row (Accordion Header)
      html += `
        <tr class="job-group-row" onclick="toggleGroup('${job.jobCode}')">
            <td colspan="7">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <span class="toggle-icon" id="icon-${job.jobCode}">▶</span>
                        <span class="job-group-title">Job ID: ${job.jobCode}</span>
                        <span class="job-group-meta">Role: ${job.role} | Location: ${job.location}</span>
                    </div>
                    <div style="font-size:12.5px; font-weight:600; color:var(--navy);">
                        ${candCount} Applicant(s)
                    </div>
                </div>
            </td>
        </tr>
      `;

      // 2. The Sub-Rows (Candidates or Empty State)
      if (candCount === 0) {
          html += `
          <tr class="child-of-${job.jobCode}" style="display:none;">
              <td colspan="7" class="empty-row">
                  No applicants yet. Click "+ Add Candidate" or "Sync Email Resumes" to add candidates to this Job ID.
              </td>
          </tr>`;
      } else {
          job.candidates.forEach(c => {
              totalCands++;
              if(c.hr && c.hr.status === 'completed') hrDone++;
              if(c.tech && c.tech.status === 'completed') techDone++;

              const outcome = finalOutcome(c);
              if(outcome.label === 'Selected') selCount++;
              if(!c.hr || c.hr.status !== 'completed' || !c.tech || c.tech.status !== 'completed') pendCount++;

              const appliedStr = c.appliedOn ? new Date(c.appliedOn).toLocaleDateString([], {dateStyle:'medium'}) : '—';

              // --- SIMPLIFIED SOURCE LOGIC ---
              let baseSource = c.source || 'Manual Entry';

              html += `
              <tr class="child-of-${job.jobCode}" style="display:none;">
                <td>
                  <div class="candidate-name">${c.name}</div>
                </td>

                <!-- SIMPLIFIED INTERACTIVE SOURCE DROPDOWN -->
                <td>
                  <!-- Note: onchange directly calls saveTableSource now -->
                  <select id="source-select-${c.id}" class="table-select" onchange="saveTableSource(${c.id})">
                    <option value="Manual Entry" ${baseSource === 'Manual Entry' ? 'selected' : ''}>Select</option>
                    <option value="LinkedIn" ${baseSource === 'LinkedIn' ? 'selected' : ''}>LinkedIn</option>
                    <option value="Naukri" ${baseSource === 'Naukri' ? 'selected' : ''}>Naukri</option>
                    <option value="Indeed" ${baseSource === 'Indeed' ? 'selected' : ''}>Indeed</option>
                    <option value="Referral" ${baseSource === 'Referral' ? 'selected' : ''}>Referral</option>
                  </select>
                </td>

                <td><span class="applied-date">${appliedStr}</span></td>
                <td>
                  <button class="btn-ghost" onclick="openResume(${c.id})">View PDF</button>
                </td>
                <td class="stage-col">${stageCellHtml(c, 'hr')}</td>
                <td class="stage-col">${stageCellHtml(c, 'tech')}</td>
                <td class="final-outcome"><span class="badge ${outcome.cls}">${outcome.label}</span></td>
              </tr>
              `;
          });
      }
  });

  document.getElementById('candidateRows').innerHTML = html;

  // Update Top Stats
  document.getElementById('statsRow').innerHTML = `
    <div class="stat"><div class="n">${totalCands}</div><div class="l">Total applicants</div></div>
    <div class="stat"><div class="n">${hrDone}</div><div class="l">HR interviews completed</div></div>
    <div class="stat"><div class="n">${techDone}</div><div class="l">Technical interviews completed</div></div>
    <div class="stat"><div class="n">${selCount}</div><div class="l">Selected</div></div>
    <div class="stat"><div class="n">${pendCount}</div><div class="l">Awaiting a stage</div></div>
  `;
}

function toggleGroup(jobCode) {
    const childRows = document.querySelectorAll(`.child-of-${jobCode}`);
    const icon = document.getElementById(`icon-${jobCode}`);

    // Check if the first row is hidden
    let isCurrentlyHidden = (childRows.length > 0 && childRows[0].style.display === 'none');

    // Toggle display
    childRows.forEach(row => {
        row.style.display = isCurrentlyHidden ? 'table-row' : 'none';
    });

    // Toggle icon rotation
    if (icon) {
        if (isCurrentlyHidden) {
            icon.classList.add('open');
        } else {
            icon.classList.remove('open');
        }
    }
}
/* ---------------- Helper to find candidate in nested structure ---------------- */
function getCandidateById(id) {
    for (const job of candidates) {
        const found = job.candidates.find(x => x.id === id);
        if (found) return found;
    }
    return null;
}

/* ---------------- Resume modal ---------------- */
function openResume(id){
  const c = getCandidateById(id);

  if (!c) {
      console.error("Candidate not found.");
      return;
  }

  if (!c.resumeFile || c.resumeFile === 'None') {
      alert("No resume file uploaded for this candidate.");
      return;
  }

  document.getElementById('pdfModalName').textContent = `${c.name} — Resume`;
  document.getElementById('pdfModalSub').textContent = `${c.role} • ${c.jobCode}`;

  document.getElementById('pdfFrame').src = c.resumeFile;
  document.getElementById('pdfOverlay').classList.add('open');
}

/* ---------------- Feedback & Schedule Modal ---------------- */
function openFeedback(id, stage){
  const c = getCandidateById(id);

  if (!c) return;

  const s = c[stage] || {};
  const pillHtml = `<span class="stage-pill ${stage}">${stageLabel[stage]}</span>`;

  document.getElementById('fbModalTitle').innerHTML = (s.feedback ? 'Interview Feedback' : 'Schedule / Add Feedback') + pillHtml;
  document.getElementById('fbModalSub').textContent = `${c.name} • ${c.jobCode}`;

  const body = document.getElementById('fbModalBody');

  if(s.feedback){
    const rMeta = recMeta[s.feedback.recommendation];
    const fbDateStr = s.feedback.date ? new Date(s.feedback.date).toLocaleDateString([], {dateStyle:'medium'}) : '';

    body.innerHTML = `
      <div class="fb-summary-row"><span class="k">Interview date</span><span class="v">${fbDateStr}</span></div>
      <div class="fb-summary-row"><span class="k">Round</span><span class="v">${s.feedback.round}</span></div>
      <div class="fb-summary-row"><span class="k">Interviewer</span><span class="v">${s.feedback.interviewer}</span></div>
      <div class="fb-summary-row"><span class="k">Technical skills</span><span class="v">${'★'.repeat(s.feedback.technical)}${'☆'.repeat(5-s.feedback.technical)}</span></div>
      <div class="fb-summary-row"><span class="k">Communication</span><span class="v">${'★'.repeat(s.feedback.communication)}${'☆'.repeat(5-s.feedback.communication)}</span></div>
      <div class="fb-summary-row"><span class="k">Problem solving</span><span class="v">${'★'.repeat(s.feedback.problemSolving)}${'☆'.repeat(5-s.feedback.problemSolving)}</span></div>
      <div class="fb-summary-row"><span class="k">Culture fit</span><span class="v">${'★'.repeat(s.feedback.cultureFit)}${'☆'.repeat(5-s.feedback.cultureFit)}</span></div>
      <div class="fb-summary-row"><span class="k">Recommendation</span><span class="v"><span class="badge ${rMeta.cls}">${rMeta.label}</span></span></div>
      <div class="fb-comment-box">${s.feedback.comments}</div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="closeModal('fbOverlay')">Close</button>
        <button class="btn-save" onclick="editFeedback(${c.id}, '${stage}')">Edit feedback</button>
      </div>
    `;
  } else {
    renderFeedbackForm(c, stage, {});
  }

  document.getElementById('fbOverlay').classList.add('open');
}

function editFeedback(id, stage){
  const c = getCandidateById(id);
  if(c) renderFeedbackForm(c, stage, c[stage].feedback || {});
}

function renderFeedbackForm(c, stage, existing){
  const body = document.getElementById('fbModalBody');
  const s = c[stage];
  const defaultRound = stage === 'hr' ? 'HR Screening' : 'Technical — Round 1';

  const ratingFields = [
    { key: 'technical', label: stage === 'hr' ? 'Role fit' : 'Technical skills' },
    { key: 'communication', label: 'Communication' },
    { key: 'problemSolving', label: 'Problem solving' },
    { key: 'cultureFit', label: 'Culture fit' },
  ];

  body.innerHTML = `
    <div class="ff-grid">
      <div class="ff-field">
        <label>Interview Date / Schedule</label>
        <input type="datetime-local" id="ffDate" value="${existing.date || s.interviewDate || ''}">
      </div>
      <div class="ff-field">
        <label>Round</label>
        <input type="text" id="ffRound" value="${existing.round || defaultRound}" placeholder="e.g., Technical — Round 1">
      </div>
      <div class="ff-field span-2">
        <label>Interviewer name</label>
        <input type="text" id="ffInterviewer" value="${existing.interviewer || s.interviewer || ''}" placeholder="Enter name">
      </div>
    </div>

    <div id="ratingBlock"></div>

    <label style="font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#565b68;display:block;margin-bottom:10px;">Overall recommendation</label>
    <div class="rec-options" id="recOptions">
      <div class="rec-opt sel-strongly" data-val="strongly">Strongly Recommend</div>
      <div class="rec-opt sel-recommend" data-val="recommend">Recommend</div>
      <div class="rec-opt sel-hold" data-val="hold">Hold</div>
      <div class="rec-opt sel-reject" data-val="reject">Do Not Recommend</div>
    </div>

    <div class="ff-field span-2" style="margin-bottom:6px;">
      <label>Comments</label>
      <textarea id="ffComments" placeholder="Summarize strengths, gaps, and reasoning behind the recommendation...">${existing.comments || ''}</textarea>
    </div>

    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeModal('fbOverlay')">Cancel</button>
      <button class="btn-save" style="background:#565b68;" onclick="submitSchedule(${c.id}, '${stage}')">Just Schedule</button>
      <button class="btn-save" onclick="submitFeedback(${c.id}, '${stage}')">Save feedback</button>
    </div>
  `;

  const ratingBlock = document.getElementById('ratingBlock');
  ratingBlock.innerHTML = ratingFields.map(f => `
    <div class="rating-row" data-key="${f.key}">
      <span class="rl">${f.label}</span>
      <div class="stars">
        ${[1,2,3,4,5].map(n => `<svg class="star ${ (existing[f.key]||0) >= n ? 'filled':'' }" data-val="${n}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`).join('')}
      </div>
    </div>
  `).join('');

  ratingBlock.querySelectorAll('.rating-row').forEach(row => {
    row.querySelectorAll('.star').forEach(star => {
      star.addEventListener('click', () => {
        const val = parseInt(star.dataset.val);
        row.querySelectorAll('.star').forEach(s2 => { s2.classList.toggle('filled', parseInt(s2.dataset.val) <= val); });
        row.dataset.rating = val;
      });
    });
    if(row.dataset.rating === undefined){
      row.dataset.rating = row.querySelectorAll('.star.filled').length;
    }
  });

  const recOptions = document.querySelectorAll('#recOptions .rec-opt');
  recOptions.forEach(opt => {
    if(existing.recommendation === opt.dataset.val) opt.classList.add('active');
    opt.addEventListener('click', () => {
      recOptions.forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
      document.getElementById('recOptions').dataset.selected = opt.dataset.val;
    });
  });

  if(existing.recommendation) document.getElementById('recOptions').dataset.selected = existing.recommendation;
}

async function submitSchedule(id, stage){
  const dateVal = document.getElementById('ffDate').value;
  const interviewerVal = document.getElementById('ffInterviewer').value || 'Unassigned';

  if (!dateVal) {
      alert("Please select a date and time to schedule the interview.");
      return;
  }

  try {
      const response = await fetch('/api/schedule', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
              candidate_id: id,
              stage: stage,
              date: dateVal,
              interviewer: interviewerVal
          })
      });

      const result = await response.json();
      if (result.status === 'success') {
          closeModal('fbOverlay');
          loadCandidates();
      }
  } catch (error) {
      console.error("Error scheduling:", error);
      alert("Failed to schedule interview.");
  }
}

async function submitFeedback(id, stage){
  const ratingBlock = document.getElementById('ratingBlock');
  const getRating = key => parseInt(ratingBlock.querySelector(`.rating-row[data-key="${key}"]`).dataset.rating || 0);
  const recommendation = document.getElementById('recOptions').dataset.selected;

  if(!recommendation){
    alert('Please select an overall recommendation before saving.');
    return;
  }

  const payload = {
      candidate_id: id,
      stage: stage,
      feedback: {
          date: document.getElementById('ffDate').value.split('T')[0] || new Date().toISOString().split('T')[0],
          round: document.getElementById('ffRound').value,
          interviewer: document.getElementById('ffInterviewer').value || 'Unassigned',
          technical: getRating('technical'),
          communication: getRating('communication'),
          problemSolving: getRating('problemSolving'),
          cultureFit: getRating('cultureFit'),
          recommendation: recommendation,
          comments: document.getElementById('ffComments').value
      }
  };

  try {
      const response = await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
      });

      const result = await response.json();
      if (result.status === 'success') {
          closeModal('fbOverlay');
          loadCandidates();
      }
  } catch (error) {
      console.error("Error saving feedback:", error);
      alert("Failed to save feedback.");
  }
}

/* ---------------- Modal helpers ---------------- */
function closeModal(id){
  document.getElementById(id).classList.remove('open');
  if(id === 'pdfOverlay') document.getElementById('pdfFrame').src = '';
}

document.querySelectorAll('.modal-overlay').forEach(ov => {
  ov.addEventListener('click', (e) => { if(e.target === ov) closeModal(ov.id); });
});

document.addEventListener('keydown', (e) => {
  if(e.key === 'Escape'){ document.querySelectorAll('.modal-overlay.open').forEach(ov => closeModal(ov.id)); }
});

/* ---------------- Init ---------------- */
document.addEventListener("DOMContentLoaded", () => {
    loadCandidates();
});
</script>
</body>
</html>
