@app.route('/api/schedule', methods=['POST'])
def schedule_interview():
    """Save or update an interview schedule."""
    data = request.json
    candidate_id = data['candidate_id']
    stage = data['stage']
    date = data['date']  # Expected format: YYYY-MM-DDTHH:MM
    interviewer = data['interviewer']

    conn = get_db_connection()
    try:
        with conn.cursor() as c:
            # Check if this stage already exists for the candidate
            c.execute("SELECT interview_id FROM candidate_interviews WHERE candidate_id=%s AND stage_type=%s",
                      (candidate_id, stage))
            row = c.fetchone()

            if row:
                c.execute('''UPDATE candidate_interviews 
                             SET stage_status='scheduled', interview_date=%s, interviewer_name=%s 
                             WHERE interview_id=%s''',
                          (date, interviewer, row['interview_id']))
            else:
                c.execute('''INSERT INTO candidate_interviews 
                             (candidate_id, stage_type, stage_status, interview_date, interviewer_name) 
                             VALUES (%s, %s, 'scheduled', %s, %s)''',
                          (candidate_id, stage, date, interviewer))
        conn.commit()
    finally:
        conn.close()

    return jsonify({"status": "success", "message": "Interview scheduled successfully"})


@app.route('/api/feedback', methods=['POST'])
def save_feedback():
    """Save feedback and mark the interview stage as completed."""
    data = request.json
    candidate_id = data['candidate_id']
    stage = data['stage']
    feedback = data['feedback']

    conn = get_db_connection()
    try:
        with conn.cursor() as c:
            c.execute("SELECT interview_id FROM candidate_interviews WHERE candidate_id=%s AND stage_type=%s",
                      (candidate_id, stage))
            row = c.fetchone()

            if not row:
                c.execute('''INSERT INTO candidate_interviews (candidate_id, stage_type, stage_status, interviewer_name) 
                             VALUES (%s, %s, 'completed', %s)''', (candidate_id, stage, feedback['interviewer']))
                interview_id = c.lastrowid
            else:
                interview_id = row['interview_id']
                c.execute('''UPDATE candidate_interviews 
                             SET stage_status='completed', interviewer_name=%s 
                             WHERE interview_id=%s''', (feedback['interviewer'], interview_id))

            # Next, insert or update the actual feedback scores
            c.execute("SELECT feedback_id FROM interview_feedback WHERE interview_id=%s", (interview_id,))
            fb_row = c.fetchone()

            if fb_row:
                c.execute('''UPDATE interview_feedback SET 
                             feedback_date=%s, round_name=%s, technical_score=%s, communication_score=%s, 
                             problem_solving_score=%s, culture_fit_score=%s, recommendation=%s, comments=%s
                             WHERE feedback_id=%s''',
                          (feedback['date'], feedback['round'], feedback['technical'], feedback['communication'],
                           feedback['problemSolving'], feedback['cultureFit'], feedback['recommendation'],
                           feedback['comments'], fb_row['feedback_id']))
            else:
                c.execute('''INSERT INTO interview_feedback 
                             (interview_id, feedback_date, round_name, technical_score, communication_score, problem_solving_score, culture_fit_score, recommendation, comments)
                             VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)''',
                          (interview_id, feedback['date'], feedback['round'], feedback['technical'],
                           feedback['communication'],
                           feedback['problemSolving'], feedback['cultureFit'], feedback['recommendation'],
                           feedback['comments']))
        conn.commit()
    finally:
        conn.close()

    return jsonify({"status": "success", "message": "Feedback saved successfully"})


@app.route('/api/upload_resume', methods=['POST'])
def upload_resume():
    """Upload a resume PDF and map it to a candidate."""
    if 'resume' not in request.files:
        return jsonify({"error": "No file part"}), 400

    file = request.files['resume']
    candidate_id = request.form.get('candidate_id')

    if file.filename == '':
        return jsonify({"error": "No selected file"}), 400

    if file and file.filename.endswith('.pdf'):
        filename = secure_filename(file.filename)
        unique_filename = f"cand_{candidate_id}_{filename}"
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], unique_filename)
        file.save(filepath)

        db_path = f"/{filepath}"
        conn = get_db_connection()
        try:
            with conn.cursor() as c:
                c.execute("UPDATE candidate_mast SET resume_path=%s WHERE candidate_id=%s", (db_path, candidate_id))
            conn.commit()
        finally:
            conn.close()

        return jsonify({"status": "success", "path": db_path})

    return jsonify({"error": "Invalid file format. Please upload a PDF."}), 400


